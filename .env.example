# Copy to .env for local runs. When hosting, set these as the host's secrets/env vars instead.
PORT=3000

# --- Accounts (users, sessions, reading history) ---
# MongoDB connection string, e.g. a free Atlas M0 cluster:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave empty for local development: accounts then go to data/lawlens.db (SQLite).
MONGODB_URI=
MONGODB_DB=lawlens
# Set to 1 when running behind a hosting proxy (Render, …) so per-IP limits see real client IPs.
TRUST_PROXY=

# --- Law search index ---
# Prebuilt per-state indexes (GitHub release built by .github/workflows/build-index.yml). Leave unset for the
# default; set it empty to index every state locally from the Open US Law parquet files instead.
# INDEX_URL=
# Indexes fetched at startup so the first search is instant (comma-separated; empty = none)
PRELOAD=federal,ca

# --- Law data sources (optional) ---
# Free key: https://openstates.org/accounts/signup/  (enables state legislation search)
OPENSTATES_API_KEY=
# Free key: https://api.data.gov/signup/  (US Code + Public Laws; DEMO_KEY is used if empty)
GOVINFO_API_KEY=

# --- AI Analyst (your key powers it for every visitor; nobody else needs one) ---
# Free keys: Gemini https://aistudio.google.com/apikey · Groq https://console.groq.com/keys · OpenRouter https://openrouter.ai/keys
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: defaults to gemini-2.5-flash / llama-3.3-70b-versatile / meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=
# Protect your free quota: require sign-in for AI (true/false) and cap requests per user (or per IP) per hour
AI_REQUIRE_ACCOUNT=true
AI_REQUESTS_PER_HOUR=30
# How much of a law's text is sent to the AI (characters)
AI_CONTEXT_CHARS=30000
