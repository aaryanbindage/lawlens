# Optional server-wide keys. Users can also add their own in Settings.
PORT=3000
# Free key: https://openstates.org/accounts/signup/  (enables state legislation search)
OPENSTATES_API_KEY=
# Free key: https://api.data.gov/signup/  (US Code + Public Laws; DEMO_KEY is used if empty)
GOVINFO_API_KEY=

# --- AI Analyst (your key powers it for every visitor; nobody else needs one) ---
# Free keys: Gemini https://aistudio.google.com/apikey · Groq https://console.groq.com/keys · OpenRouter https://openrouter.ai/keys
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: defaults to gemini-2.5-flash / llama-3.3-70b-versatile / meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=
# Protect your free quota: require sign-in for AI (true/false) and cap requests per user (or per IP) per hour
AI_REQUIRE_ACCOUNT=true
AI_REQUESTS_PER_HOUR=30
# How much of a law's text is sent to the AI (characters)
AI_CONTEXT_CHARS=30000
